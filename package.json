{
  "name": "@curl-runner",
  "version": "1.0.0",
  "private": true,
  "description": "curl-runner monorepo - CLI tool and documentation",
  "scripts": {
    "start:docs": "pnpm --filter '@curl-runner/docs' start",
    "dev": "pnpm --filter '*' dev",
    "dev:docs": "pnpm --filter '@curl-runner/docs' dev",
    "build": "pnpm --filter '*' build",
    "build:docs": "pnpm --filter '@curl-runner/docs' build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "pnpm --filter '*' typecheck",
    "typecheck:docs": "pnpm --filter '@curl-runner/docs' typecheck",
    "test": "cargo test --workspace",
    "changeset": "changeset",
    "version": "changeset version && bash scripts/sync-cargo-version.sh",
    "release": "changeset publish",
    "prepare": "husky",
    "cli": "cargo run -q -p curl-runner --",
    "build:cli": "cargo build --release -p curl-runner"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexvcasillas/curl-runner.git"
  },
  "keywords": [
    "curl",
    "http",
    "api",
    "testing",
    "yaml",
    "cli",
    "documentation",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@pulsora/core": "1.0.1"
  }
}
