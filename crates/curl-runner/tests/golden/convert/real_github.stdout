request:
  method: POST
  url: https://api.github.com/repos/octocat/Hello-World/issues
  headers:
    Accept: application/vnd.github+json
    X-Github-Api-Version: 2022-11-28
  auth:
    type: bearer
    token: ghp_xxxxxxxxxxxx
  body:
    title: Found a bug
    body: I'm having a problem with this.
    labels: ["bug"]
  followRedirects: true

